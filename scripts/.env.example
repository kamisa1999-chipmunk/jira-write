# Скопируй в .env и заполни (файл .env не коммить!)
JIRA_URL=https://jira01.goldapple.ru
JIRA_PROJECT=CAT2

# Вариант 1 (рекомендуется): Personal Access Token
# Jira → Profile → Personal Access Tokens → Create token
JIRA_PAT=

# Вариант 2: логин + пароль (если PAT недоступен)
# JIRA_USERNAME=
# JIRA_PASSWORD=

# Необязательно: id доски, если в проекте несколько досок
# JIRA_BOARD_ID=

# JIRA_STORY_POINTS_FIELD=customfield_10004

# --- Confluence (отдельный токен, Jira PAT сюда не подходит) ---
# Confluence → аватар → Settings → Personal access tokens → Create token
# Прямая ссылка: https://confluence.goldapple.ru/plugins/personalaccesstokens/usertokens.action
CONFLUENCE_URL=https://confluence.goldapple.ru
CONFLUENCE_PAT=
# Запасной вариант, если PAT в Confluence отключён админами:
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=

# --- GitLab / GitHub (отдельный токен, не смешивать с JIRA_PAT) ---
# Нужен только для get_issue_history.py --with-git
GITLAB_URL=https://git.goldapple.ru
GITLAB_PAT=
# GIT_PROVIDER=gitlab
# GITHUB_URL=https://api.github.com
# GITHUB_PAT=
